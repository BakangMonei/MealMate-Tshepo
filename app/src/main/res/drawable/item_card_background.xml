<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#B3B3B3" /> <!-- Shadow color -->
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C1C1C" /> <!-- Card background color (dark gray) -->
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
